# Server Configuration
PORT=4000
NODE_ENV=development
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database Configuration (Docker Local Default)
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/task_server

# Authentication Secrets (Generate secure strings for local testing)
ACCESS_TOKEN_SECRET_KEY=local_access_token_secret_string_32_chars_long
ACCESS_TOKEN_EXPIRY_PERIOD=15m
REFRESH_TOKEN_SECRET_KEY=local_refresh_token_secret_string_32_chars_long
REFRESH_TOKEN_EXPIRY_PERIOD=7d

# Cookie Configuration (Set to false for local HTTP testing, true for HTTPS production)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Caching Layer (Docker Local Default)
REDIS_URL=redis://localhost:6379
GET_ALL_CACHED_TASK_EXPIRY=300

# Rate Limiting Parameters
AUTH_RATE_LIMIT_MAX_REQUEST=5
RATE_LIMIT_WINDOW_SECONDS=60

REFRESH_COOKIE_RATE_LIMIT_MAX_REQUESTS=5
REFRESH_COOKIE_RATE_LIMIT_WINDOW_SECONDS=900
